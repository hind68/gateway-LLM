{
  "realm": "synapse",
  "enabled": true,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Regular gateway user" },
      { "name": "ADMIN", "description": "Gateway administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "synapse-client",
      "name": "Synapse Gateway",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@local.test",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ],
      "realmRoles": ["USER", "ADMIN"]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@local.test",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "user", "temporary": false }
      ],
      "realmRoles": ["USER"]
    }
  ]
}
